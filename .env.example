# Backend runtime
ENVIRONMENT=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model providers
OPENAI_API_BASE=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
TAVILY_API_KEY=

# Redis
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# Knowledge metadata
# redis keeps the current lightweight local mode; postgres stores knowledge
# base/document metadata in PostgreSQL.
KNOWLEDGE_METADATA_BACKEND=redis
POSTGRES_DSN=postgresql://amas:change-me@postgres:5432/amas
POSTGRES_PASSWORD=change-me
POSTGRES_AUTO_MIGRATE=true

# Optional local seed account. Password is hashed before it is stored.
SEED_DEFAULT_USER_ENABLED=false
SEED_DEFAULT_TENANT_NAME=Default Tenant
SEED_DEFAULT_USERNAME=
SEED_DEFAULT_PASSWORD=

# Auth token signing
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_TTL_SECONDS=86400

# Upload limits
UPLOAD_MAX_FILES=5
UPLOAD_MAX_FILE_SIZE_BYTES=20971520
UPLOAD_ALLOWED_EXTENSIONS=.pdf
UPLOAD_ALLOWED_CONTENT_TYPES=application/pdf

# ── 分层记忆系统 ──────────────────────────────────────────────
# 总开关：关闭后记忆层退化为仅"Redis 回合 + Chroma 摘要"（原行为）
MEMORY_ENABLED=true
# 冷热迁移时间窗（天）：热记忆超过 WARM_DAYS 未访问 → 归档冷层；
# 冷层保留超过 COLD_RETENTION_DAYS → 永久删除（protected 除外）
MEMORY_WARM_DAYS=10
MEMORY_COLD_RETENTION_DAYS=30
# 图谱抽取回合数门槛（单会话累计回合达到才做 LLM 结构化抽取）
MEMORY_CONSOLIDATE_MIN_TURNS=10
# 记忆维护周期（秒，默认 6 小时）
MEMORY_MAINTENANCE_INTERVAL_SECONDS=21600
